#include <stdio.h>
#include <stdbool.h>

#define Max_N 1001
#define Max_M 1001
#define Max_slot 1001

int N, M, K;
int c[Max_M];           
int d[Max_N];          
bool Conflict[Max_N][Max_N] = { false };

int Slot[Max_N] = { 0 };
int Room[Max_N] = { 0 };
bool Used[Max_M][Max_slot] = { false };
bool NeighborSlot[Max_N][Max_slot] = { false };

int Degree[Max_N];                   
int SatDeg[Max_N] = { 0 };           
bool Colored[Max_N] = { false };

int RoomCount[Max_N];               
int AvailableRoom[Max_N][Max_M];    
int Order[Max_N];

void Input() {
    scanf("%d %d", &N, &M);
    for (int i = 1; i <= N; i++) {
        scanf("%d", &d[i]);
        Order[i] = i;
    }
    for (int j = 1; j <= M; j++) {
        scanf("%d", &c[j]);
    }
    scanf("%d", &K);
    for (int i = 1; i <= K; i++) {
        int u, v;
        scanf("%d %d", &u, &v);
        Conflict[u][v] = true;
        Conflict[v][u] = true;
    }
}

void BuildRoomListAndDegree() {
    for (int i = 1; i <= N; i++) {
        RoomCount[i] = 0;
        Degree[i] = 0;
        for (int j = 1; j <= N; j++) {
            if (Conflict[i][j]) Degree[i]++;
        }
        for (int j = 1; j <= M; j++) {
            if (c[j] >= d[i]) {
                AvailableRoom[i][RoomCount[i]++] = j;
            }
        }
        for (int x = 0; x < RoomCount[i]; x++) {
            for (int y = x + 1; y < RoomCount[i]; y++) {
                if (c[AvailableRoom[i][x]] > c[AvailableRoom[i][y]]) {
                    int tmp = AvailableRoom[i][x];
                    AvailableRoom[i][x] = AvailableRoom[i][y];
                    AvailableRoom[i][y] = tmp;
                }
            }
        }
    }
    // Sort classes by degree descending
    for (int i = 1; i < N; i++) {
        for (int j = i + 1; j <= N; j++) {
            if (Degree[Order[i]] < Degree[Order[j]]) {
                int tmp = Order[i];
                Order[i] = Order[j];
                Order[j] = tmp;
            }
        }
    }
}

void DSatur() {
    int coloredCount = 0;
    while (coloredCount < N) {
        int next = 0;
        int maxSat = -1;
        int maxDeg = -1;

        for (int t = 1; t <= N; t++) {
            int i = Order[t];
            if (!Colored[i]) {
                if (SatDeg[i] > maxSat || (SatDeg[i] == maxSat && Degree[i] > maxDeg)) {
                    maxSat = SatDeg[i];
                    maxDeg = Degree[i];
                    next = i;
                }
            }
        }

        int chosen_slot = 0;
        for (int s = 1; s <= Max_slot; s++) {
            if (!NeighborSlot[next][s]) {
                chosen_slot = s;
                break;
            }
        }

        bool assigned = false;
        for (int r = 0; r < RoomCount[next]; r++) {
            int room = AvailableRoom[next][r];
            if (!Used[room][chosen_slot]) {
                Slot[next] = chosen_slot;
                Room[next] = room;
                Used[room][chosen_slot] = true;
                Colored[next] = true;
                coloredCount++;

                for (int j = 1; j <= N; j++) {
                    if (Conflict[next][j]) {
                        if (!NeighborSlot[j][chosen_slot]) {
                            NeighborSlot[j][chosen_slot] = true;
                            SatDeg[j]++;
                        }
                    }
                }

                assigned = true;
                break;
            }
        }

        if (!assigned) {
            for (int s = chosen_slot + 1; s <= Max_slot && !assigned; s++) {
                if (NeighborSlot[next][s]) continue;
                for (int r = 0; r < RoomCount[next]; r++) {
                    int room = AvailableRoom[next][r];
                    if (!Used[room][s]) {
                        Slot[next] = s;
                        Room[next] = room;
                        Used[room][s] = true;
                        Colored[next] = true;
                        coloredCount++;

                        for (int j = 1; j <= N; j++) {
                            if (Conflict[next][j]) {
                                if (!NeighborSlot[j][s]) {
                                    NeighborSlot[j][s] = true;
                                    SatDeg[j]++;
                                }
                            }
                        }

                        assigned = true;
                        break;
                    }
                }
            }
        }
    }
}

void Print() {
    for (int i = 1; i <= N; i++) {
        printf("%d %d %d\n", i, Slot[i], Room[i]);
    }
}

int main() {
    Input();
    BuildRoomListAndDegree();
    DSatur();
    Print();
    return 0;
}
